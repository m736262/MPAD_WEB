@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    Layout = null;
    ViewData["Title"] = "MBOX Karaoke";

    var loginApiUrl = Configuration["ApiSettings:LoginApiUrl"];
    var appKey = Configuration["ApiSettings:appKey"];
    var img = Configuration["ApiSettings:imgUrl"];
    var sound = Configuration["ApiSettings:soundUrl"];
}

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MBOX Karaoke</title>

    <!-- 1. Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- 2. Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "background": "#0e0e12",
                "surface-container": "#19191e",
                "surface-container-high": "#1f1f25",
                "surface-container-highest": "#25252b",
                "primary": "#81ecff",
                "secondary": "#ac8aff",
                "on-surface": "#f3eff6",
                "on-surface-variant": "#acaab0",
                "outline-variant": "#48474c"
              },
              borderRadius: {
                "DEFAULT": "0.5rem",
                "lg": "1rem",
                "xl": "1.5rem",
                "2xl": "2rem",
                "full": "9999px"
              }
            }
          }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal;
            font-style: normal;
            font-size: 24px;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-smoothing: antialiased;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Custom styling for range input track & thumb */
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 18px;
            width: 18px;
            border-radius: 50%;
            background: #00e5ff;
            box-shadow: 0 0 10px rgba(0, 229, 255, 0.8);
            cursor: pointer;
            margin-top: -6px;
        }

        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 6px;
            cursor: pointer;
            background: #25252b;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-['Inter'] min-h-screen pb-32 select-none">

    <!-- Top Navigation Bar -->
    <nav class="fixed top-0 w-full z-50 bg-[#0e0e12]/80 backdrop-blur-xl flex justify-between items-center px-6 h-16 shadow-[0_2px_20px_rgba(0,229,255,0.05)]">
        <div class="flex items-center gap-2 transition-colors duration-300 text-slate-500" id="connectionStatusContainer">
            <!-- ไอคอนสถานะ -->
            <span class="material-symbols-outlined text-xl" id="connectionIcon">sensors_off</span>

            <!-- ข้อความแสดง User ID และ Status -->
            <span class="font-['Plus_Jakarta_Sans'] font-bold text-sm" id="connectionStatusText">Loading...</span>
        </div>

        <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high text-primary border border-primary/20 text-xs font-bold font-['Plus_Jakarta_Sans']">
            <span class="material-symbols-outlined text-sm">timer</span>
            <span id="roomTimer">42:15</span>
        </div>
    </nav>

    <main class="pt-20 px-6 max-w-2xl mx-auto">

        <!-- Search Input Bar -->
        <section class="mb-6" id="searchBarSection">
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-5 text-primary text-2xl pointer-events-none">search</span>
                <input id="searchInput"
                       oninput="handleSearchInput(this.value)"
                       onfocus="switchMode('search')"
                       class="w-full bg-surface-container h-14 pl-14 pr-12 rounded-2xl border-none text-base font-medium text-on-surface focus:ring-2 focus:ring-primary placeholder:text-outline-variant/60 transition-all shadow-md"
                       placeholder="Search songs by title or artist"
                       type="text"
                       autocomplete="off" />
                <button type="button"
                        onclick="clearSearch()"
                        class="absolute right-4 text-outline-variant hover:text-on-surface transition-colors p-1 flex items-center justify-center">
                    <span class="material-symbols-outlined text-xl">close</span>
                </button>
            </div>
        </section>

        <!-- Category Filter Chips -->
        <section id="categoryContainer" class="mb-8 overflow-x-auto hide-scrollbar flex gap-2.5 -mx-6 px-6">
            <div class="h-9 w-16 bg-surface-container-highest rounded-full animate-pulse shrink-0"></div>
            <div class="h-9 w-24 bg-surface-container-highest rounded-full animate-pulse shrink-0"></div>
            <div class="h-9 w-20 bg-surface-container-highest rounded-full animate-pulse shrink-0"></div>
        </section>

        <!-- ================= VIEW 1: HOME ================= -->
        <div id="homeView" class="space-y-6 pb-36">
            <!-- Popular Songs -->
            <section class="mb-10">
                <div class="flex justify-between items-center mb-5">
                    <h2 class="text-xl font-headline font-bold">Popular</h2>
                    <button class="text-primary text-[10px] font-bold uppercase tracking-widest">See All</button>
                </div>
                <!-- 📌 ใส่ id="tophitContainer" ตรงนี้ -->
                <div id="tophitContainer" class="flex gap-5 overflow-x-auto no-scrollbar pb-2 snap-x">
                    <!-- Loading State เบื้องต้น -->
                    <div class="text-xs text-on-surface-variant py-4">Loading top hits...</div>
                </div>
            </section>
            <!-- New Releases -->
            <section class="mb-10">
                <div class="flex justify-between items-center mb-5">
                    <h2 class="text-xl font-headline font-bold">New Releases</h2>
                    <button class="text-primary text-[10px] font-bold uppercase tracking-widest">See All</button>
                </div>
                <div class="flex gap-5 overflow-x-auto no-scrollbar pb-2 snap-x">
                    <!-- Song Card 4 -->
                    <div class="flex-none w-44 snap-start group">
                        <div class="relative mb-3 aspect-square overflow-hidden rounded-2xl card-bg shadow-xl transition-transform duration-300 group-hover:scale-[1.02]">
                            <img class="w-full h-full object-cover opacity-90" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCtiUpZjpxhVN5J2KJJdUj9e4LD3yONrpzM_f1sVrH89ZmrU-ACvNynoI0eEcHa24d3OMaepPLWnINhhcjj5fZbIIqx2EXNoBeUQc9iiWjFHopntBhfboOy5m9E8dPwvm4jwgUoPgzzf3zi-DzTjR0ziu69SIj-SzeAM8TiSsKgqHDF4pGAk-vclysP18HwOM9vYfekQmDKxhByqF61HBodWlYcEefsC_zDnzYf516jAEsZ8RvzsQju2zRN967dDyWzT42n_5L-dlv2" />
                            <div class="absolute bottom-3 right-3">
                                <button class="w-9 h-9 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                    <span class="material-symbols-outlined text-xl" data-icon="add" style="font-variation-settings: 'wght' 600;">add</span>
                                </button>
                            </div>
                            <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded text-[9px] font-bold text-white border border-white/10 uppercase">EN</span>
                        </div>
                        <h3 class="font-bold text-sm truncate mb-0.5 group-hover:text-primary transition-colors">Seven</h3>
                        <p class="text-on-surface-variant text-xs">Jungkook ft. Latto</p>
                    </div>
                    <!-- Song Card 5 -->
                    <div class="flex-none w-44 snap-start group">
                        <div class="relative mb-3 aspect-square overflow-hidden rounded-2xl card-bg shadow-xl transition-transform duration-300 group-hover:scale-[1.02]">
                            <img class="w-full h-full object-cover opacity-90" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBLUnsvX1EpS5r4RhOGBxpzsQt-4fGTEUnfE30jgsPP7kqq3eEsoMFcDdAVcaSUWpR4Dmg8Y0y3qb7lYLz3FTbkYQ1dVitmubW_GNZlhG7MR8UDMHa04ar9GQjv0Dohu7fID3gmvh-lqiRov0BGf3WYi9DaNmxQUOwi7dQxnekVtLDw1h2Th5cPW3zjT_WymtaIfoKoAjTX-auPEzH7I7_6AvWKpzBqRKk_es6QxpoY4_5krY8K9efihEY_aRawbyHg1j9NhXYaNbR5" />
                            <div class="absolute bottom-3 right-3">
                                <button class="w-9 h-9 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                    <span class="material-symbols-outlined text-xl" data-icon="add" style="font-variation-settings: 'wght' 600;">add</span>
                                </button>
                            </div>
                            <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded text-[9px] font-bold text-white border border-white/10 uppercase">EN</span>
                        </div>
                        <h3 class="font-bold text-sm truncate mb-0.5 group-hover:text-primary transition-colors">Vampire</h3>
                        <p class="text-on-surface-variant text-xs">Olivia Rodrigo</p>
                    </div>
                    <!-- Song Card 6 -->
                    <div class="flex-none w-44 snap-start group">
                        <div class="relative mb-3 aspect-square overflow-hidden rounded-2xl card-bg shadow-xl transition-transform duration-300 group-hover:scale-[1.02]">
                            <img class="w-full h-full object-cover opacity-90" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBva4z11-YcaxNMhHgF8GP9Uf3QDuyrFfgamw43sI6_AMkfaDzZn7_-0vi9UNDk9y8mnVJ2Ciyz_K4vSx-Iam-Wq3h1WLK_nDFVl-yJeEHjLdJnwUDevbqPwK-XO0_yn0ApXMVY5J3ZngUSHJB2kmeGd8Vz5txcHmYt5H_MP54O7mMUdjFkCe6wPp-S4hsGWLhZc2KXryLnazlS1zfAQ1-lct4ihjX9J8LvSqBcaUpSIOr494z_qHUZJBzsBkU1-jhMCNk1FfECkbaQ" />
                            <div class="absolute bottom-3 right-3">
                                <button class="w-9 h-9 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-lg active:scale-90 transition-transform">
                                    <span class="material-symbols-outlined text-xl" data-icon="add" style="font-variation-settings: 'wght' 600;">add</span>
                                </button>
                            </div>
                            <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded text-[9px] font-bold text-white border border-white/10 uppercase">EN</span>
                        </div>
                        <h3 class="font-bold text-sm truncate mb-0.5 group-hover:text-primary transition-colors">Dance The Night</h3>
                        <p class="text-on-surface-variant text-xs">Dua Lipa</p>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= VIEW 2: SEARCH RESULTS ================= -->
        <div id="searchView" class="hidden space-y-6 pb-36">

            <section id="recentSearchesContainer">
                <h3 class="text-[11px] uppercase tracking-[0.2em] font-black text-outline-variant mb-3">Recent Searches</h3>
                <div class="flex flex-wrap gap-2">
                    <button onclick="setSearchValue('Bruno Mars')" class="bg-surface-container-high px-3 py-1.5 rounded-xl text-xs text-on-surface-variant border border-outline-variant/10 flex items-center gap-1.5 hover:text-on-surface">
                        <span>Bruno Mars</span>
                        <span class="material-symbols-outlined text-xs">history</span>
                    </button>
                    <button onclick="setSearchValue('Billie Eilish')" class="bg-surface-container-high px-3 py-1.5 rounded-xl text-xs text-on-surface-variant border border-outline-variant/10 flex items-center gap-1.5 hover:text-on-surface">
                        <span>Billie Eilish</span>
                        <span class="material-symbols-outlined text-xs">history</span>
                    </button>
                </div>
            </section>

            <section>
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-lg text-on-surface">Search Results</h3>
                    <span id="matchCount" class="text-xs font-bold text-primary tracking-wider uppercase">0 Matches</span>
                </div>

                <div id="resultsContainer" class="space-y-3">
                    <!-- ผลลัพธ์จะถูกแสดงตรงนี้ -->
                </div>
            </section>

        </div>

        <!-- ================= VIEW 3: QUEUE SCREEN ================= -->
        <div id="queueView" class="hidden space-y-6">

            <!-- Tag & Header -->
            <div>
                <div class="inline-block px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 font-bold text-[10px] tracking-widest uppercase mb-2">
                    QUEUE FAIRNESS ACTIVE
                </div>
                <h2 class="text-3xl font-extrabold text-on-surface font-['Plus_Jakarta_Sans']">Up Next</h2>
                <p class="text-xs text-on-surface-variant mt-1" id="nextTurnInfo">Next up: 2nd turn for Beer</p>
            </div>

            <!-- Card 1: Now Playing (Glowing Effect) -->
            <div class="relative group">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-primary to-cyan-500 rounded-3xl blur opacity-20 group-hover:opacity-40 transition duration-300"></div>

                <div class="relative bg-surface-container p-4 rounded-3xl border border-white/5 shadow-2xl space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3.5 min-w-0 pr-2">
                            <div id="nowPlayingImgContainer" class="relative w-14 h-14 shrink-0 rounded-2xl overflow-hidden bg-surface-container-highest flex items-center justify-center">
                                <span id="nowPlayingDefaultIcon" class="material-symbols-outlined text-slate-500 text-2xl">music_note</span>
                                <img id="nowPlayingImg" src="" class="w-full h-full object-cover hidden" alt="cover" />
                                <div id="nowPlayingPlayOverlay" class="absolute inset-0 bg-black/40 flex items-center justify-center hidden">
                                    <span class="material-symbols-outlined text-primary text-xl">play_arrow</span>
                                </div>
                            </div>

                            <div class="min-w-0">
                                <span class="text-[10px] font-extrabold tracking-widest text-slate-400 uppercase">NOW PLAYING</span>
                                <h4 class="font-extrabold text-on-surface text-base truncate mt-0.5" id="nowPlayingTitle">ไม่มีเพลงกำลังเล่น</h4>
                                <div class="flex items-center gap-1.5 mt-1 text-xs text-on-surface-variant">
                                    <div id="nowPlayingUserAvatar" class="w-5 h-5 rounded-full overflow-hidden shrink-0 bg-slate-700 text-slate-300 flex items-center justify-center text-[10px] font-bold">
                                        -
                                    </div>
                                    <span>Added by <strong class="text-on-surface" id="nowPlayingAddedBy">-</strong></span>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col items-end gap-3 shrink-0">
                            <span class="material-symbols-outlined text-slate-600 text-lg">drag_handle</span>
                            <span class="text-xs font-bold text-primary font-mono" id="nowPlayingDuration">00:00 / 00:00</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- List: Queue Items -->
            <div class="space-y-3" id="queueItemsContainer">
            </div>

            <!-- Bottom Stats Grid -->
            <div class="grid grid-cols-2 gap-4 pt-2">
                <div class="bg-surface-container p-5 rounded-3xl border border-white/5 flex flex-col justify-between h-36">
                    <div class="w-10 h-10 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
                        <span class="material-symbols-outlined">group</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-on-surface text-base">Session Size</h4>
                        <p class="text-xs text-on-surface-variant mt-0.5" id="sessionSizeText">8 Guests active</p>
                    </div>
                </div>

                <div class="bg-gradient-to-br from-surface-container to-pink-950/30 p-5 rounded-3xl border border-pink-500/10 flex flex-col justify-between h-36">
                    <div class="w-10 h-10 rounded-2xl bg-pink-500/10 text-pink-400 flex items-center justify-center">
                        <span class="material-symbols-outlined">favorite</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-on-surface text-base">Vibe Level</h4>
                        <p class="text-xs text-on-surface-variant mt-0.5" id="vibeLevelText">High Intensity</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= VIEW 4: NOW PLAYING FULLSCREEN SCREEN ================= -->
        <div id="playingView" class="hidden space-y-6 pb-20 animate-in fade-in duration-300">
            <!-- 🖼️ Main Cover Card -->
            <div class="relative w-full aspect-square rounded-[2rem] overflow-hidden bg-slate-900 border border-white/10 shadow-2xl flex items-center justify-center">
                <img id="playingFullCover" src="https://picsum.photos/600" class="w-full h-full object-cover" alt="Song Cover" />
            </div>

            <!-- 🎵 Track Info -->
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-pink-500 text-xs font-bold uppercase tracking-widest">
                    <span>CURRENT PERFORMANCE</span>
                    <span class="material-symbols-outlined text-sm animate-pulse">equalizer</span>
                </div>
                <h2 id="playingFullTitle" class="text-3xl font-black text-white truncate">Midnight City</h2>
                <p id="playingFullArtist" class="text-sm font-semibold text-cyan-400 truncate">M83 • Synthwave Dreams</p>
            </div>

            <!-- ⏱️ Timeline & Progress Bar -->
            <div class="space-y-2">
                <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden relative cursor-pointer">
                    <div id="playingProgressBar" class="bg-[#00e5ff] h-full w-[65%] rounded-full shadow-[0_0_12px_#00e5ff]"></div>
                </div>
                <div class="flex justify-between text-xs font-mono text-slate-400 font-semibold">
                    <span id="playingCurrentTime">02:45</span>
                    <span id="playingTotalTime">04:03</span>
                </div>
            </div>

            <!-- 🎮 Playback Controls (2 ปุ่ม ขนาดเท่ากัน) -->
            <div class="flex items-center justify-center gap-6 py-2">
                <!-- Play / Pause (กลาง) -->
                <button type="button"
                        onclick="togglePausePlay(event)"
                        id="playingMainToggle"
                        class="w-20 h-20 rounded-full bg-[#00e5ff] text-slate-950 flex items-center justify-center transition-all shadow-[0_0_30px_rgba(0,229,255,0.3)]">
                    <span id="playingFullPauseIcon" class="material-symbols-outlined text-4xl">pause</span>
                </button>

                <!-- Skip Next (ขวา) - ขนาดเท่ากันกับปุ่มกลาง -->
                <button type="button"
                        onclick="skipSong(event)"
                        id="playingSkip"
                        class="w-20 h-20 rounded-full bg-white/5 hover:bg-white/10 active:scale-95 text-white flex items-center justify-center transition-all shadow-sm">
                    <span class="material-symbols-outlined text-3xl">skip_next</span>
                </button>
            </div>

            <!-- 🔊 Volume Control Slider -->
            <!-- Volume Control + Mute Button -->
            <div class="bg-surface-container p-4 rounded-3xl border border-white/5 flex items-center gap-4">
                <span class="material-symbols-outlined text-cyan-400 text-xl">volume_up</span>

                <div class="flex-1 flex flex-col gap-1">
                    <div class="flex justify-between text-[10px] font-bold tracking-widest text-slate-400 uppercase">
                        <span>OUTPUT VOLUME</span>
                        <span id="volumeValueText" class="text-cyan-400">82</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <input type="range" id="volumeSlider" min="0" max="100" value="82"
                               class="w-full h-1 bg-slate-800 rounded-full"
                               aria-label="Volume slider" />

                        <!-- ปุ่ม Mute ขนาดเล็ก อยู่ข้างขวา -->
                        <button id="playingMuteToggle"
                                type="button"
                                title="Mute / Unmute"
                                class="ml-2 w-10 h-10 rounded-full bg-white/5 hover:bg-white/10 text-white flex items-center justify-center transition-all"
                                onclick="toggleMute(event)">
                            <span id="playingMuteIcon" class="material-symbols-outlined text-lg">volume_off</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 🎙️ Audio Channel / Voice Cut Mode Buttons -->
            <div class="bg-surface-container p-4 rounded-3xl border border-white/5 space-y-3">
                <div class="text-[10px] font-bold tracking-widest text-slate-400 uppercase text-center">
                    AUDIO CHANNEL / VOCAL CONTROL
                </div>
                <div class="grid grid-cols-3 gap-2.5">
                    <!-- Stereo Mode -->
                    <button type="button" onclick="setAudioChannel('stereo')" id="btnAudioStereo" class="py-3 px-2 rounded-2xl bg-white/5 hover:bg-white/10 active:scale-95 text-slate-300 text-xs font-bold flex flex-col items-center gap-1 transition-all border border-white/5">
                        <span class="material-symbols-outlined text-xl text-cyan-400">graphic_eq</span>
                        <span>Stereo</span>
                    </button>

                    <!-- Vocal Cut (Default Active) -->
                    <button type="button" onclick="setAudioChannel('vocal')" id="btnAudioVocal" class="py-3 px-2 rounded-2xl bg-gradient-to-b from-cyan-500/20 to-cyan-500/5 text-cyan-400 border border-cyan-500/40 text-xs font-bold flex flex-col items-center gap-1 transition-all shadow-[0_0_15px_rgba(0,229,255,0.15)]">
                        <span class="material-symbols-outlined text-xl">mic_off</span>
                        <span>Vocal</span>
                    </button>

                    <!-- Karaoke Mode -->
                    <button type="button" onclick="setAudioChannel('karaoke')" id="btnAudioKaraoke" class="py-3 px-2 rounded-2xl bg-white/5 hover:bg-white/10 active:scale-95 text-slate-300 text-xs font-bold flex flex-col items-center gap-1 transition-all border border-white/5">
                        <span class="material-symbols-outlined text-xl text-purple-400">queue_music</span>
                        <span>Karaoke</span>
                    </button>
                </div>
            </div>

            <!-- Next Up Mini Banner (เพิ่ม id ให้แต่ละส่วน) -->
            <div id="nextUpCard" class="bg-surface-container p-4 rounded-3xl border border-white/5 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors">
                <div class="flex items-center gap-3">
                    <img id="nextUpCover" src="https://picsum.photos/100" class="w-10 h-10 rounded-2xl object-cover" alt="Next song cover" />
                    <div class="min-w-0">
                        <div class="text-[9px] font-extrabold tracking-widest text-cyan-400 uppercase">NEXT UP</div>
                        <h5 id="nextUpTitle" class="font-bold text-white text-sm truncate">Flowers</h5>
                        <p id="nextUpMeta" class="text-xs text-slate-400 truncate">Miley Cyrus • Endless Summer</p>
                    </div>
                </div>
                <span id="nextUpChevron" onclick="switchMode('queue');" class="material-symbols-outlined text-slate-500">chevron_right</span>
            </div>
        </div>

