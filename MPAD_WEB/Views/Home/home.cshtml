    <script>
        // สลับหน้า View (Home <-> Search <-> Queue <-> Playing)
        function switchMode(mode) {
            const homeView = document.getElementById('homeView');
            const searchView = document.getElementById('searchView');
            const queueView = document.getElementById('queueView');
            const playingView = document.getElementById('playingView');
            const effectsView = document.getElementById('effectsView'); // <-- ใหม่

            const navHome = document.getElementById('navHome');
            const navSearch = document.getElementById('navSearch');
            const navQueue = document.getElementById('navQueue');
            const navPlaying = document.getElementById('navPlaying');
            const navEffects = document.getElementById('navEffects'); // <-- ใหม่

            const searchBarSection = document.getElementById('searchBarSection');
            const categoryContainer = document.getElementById('categoryContainer');
            const miniNowPlayingBar = document.getElementById('miniNowPlayingBar');
            const input = document.getElementById('searchInput');

            const activeNavClass = "flex flex-col items-center justify-center w-full text-primary";
            const inactiveNavClass = "flex flex-col items-center justify-center w-full text-slate-500 hover:text-primary transition-colors";

            // reset all navs to inactive
            if (navHome) navHome.className = inactiveNavClass;
            if (navSearch) navSearch.className = inactiveNavClass;
            if (navQueue) navQueue.className = inactiveNavClass;
            if (navPlaying) navPlaying.className = inactiveNavClass;
            if (navEffects) navEffects.className = inactiveNavClass; // reset

            // hide all views by default
            if (homeView) homeView.classList.add('hidden');
            if (searchView) searchView.classList.add('hidden');
            if (queueView) queueView.classList.add('hidden');
            if (playingView) playingView.classList.add('hidden');
            if (effectsView) effectsView.classList.add('hidden'); // hide effects by default

            // default visibility for header/search/minibar
            if (searchBarSection) searchBarSection.classList.remove('hidden');
            if (categoryContainer) categoryContainer.classList.remove('hidden');
            if (miniNowPlayingBar) miniNowPlayingBar.classList.remove('hidden');

            // switch
            if (mode === 'search') {
                if (searchView) searchView.classList.remove('hidden');
                if (navSearch) navSearch.className = activeNavClass;
            }
            else if (mode === 'queue') {
                if (queueView) queueView.classList.remove('hidden');
                if (searchBarSection) searchBarSection.classList.add('hidden');
                if (categoryContainer) categoryContainer.classList.add('hidden');
                if (miniNowPlayingBar) miniNowPlayingBar.classList.add('hidden');
                if (navQueue) navQueue.className = activeNavClass;
            }
            else if (mode === 'playing') {
                if (playingView) playingView.classList.remove('hidden');
                if (searchBarSection) searchBarSection.classList.add('hidden');
                if (categoryContainer) categoryContainer.classList.add('hidden');
                if (miniNowPlayingBar) miniNowPlayingBar.classList.add('hidden');
                if (navPlaying) navPlaying.className = activeNavClass;
            }
            else if (mode === 'effects') {
                // Effects: hide header/search and mini bar to focus on effects UI (ปรับได้ตามต้องการ)
                if (effectsView) effectsView.classList.remove('hidden');
                if (searchBarSection) searchBarSection.classList.add('hidden');
                if (categoryContainer) categoryContainer.classList.add('hidden');
                if (miniNowPlayingBar) miniNowPlayingBar.classList.add('hidden');
                if (navEffects) navEffects.className = activeNavClass;
            }
            else { // Home
                if (homeView) homeView.classList.remove('hidden');
                if (searchBarSection) searchBarSection.classList.remove('hidden');
                if (categoryContainer) categoryContainer.classList.remove('hidden');
                if (miniNowPlayingBar) miniNowPlayingBar.classList.remove('hidden');
                if (navHome) navHome.className = activeNavClass;
                if (input) input.value = '';
            }
        }

        // ฟังก์ชันสลับโหมดเสียง Stereo, Vocal, Karaoke
        function setAudioChannel(type) {
            const btnStereo = document.getElementById('btnAudioStereo');
            const btnVocal = document.getElementById('btnAudioVocal');
            const btnKaraoke = document.getElementById('btnAudioKaraoke');

            const inactiveStyle = "py-3 px-2 rounded-2xl bg-white/5 hover:bg-white/10 active:scale-95 text-slate-300 text-xs font-bold flex flex-col items-center gap-1 transition-all border border-white/5";
            const activeCyanStyle = "py-3 px-2 rounded-2xl bg-gradient-to-b from-cyan-500/20 to-cyan-500/5 text-cyan-400 border border-cyan-500/40 text-xs font-bold flex flex-col items-center gap-1 transition-all shadow-[0_0_15px_rgba(0,229,255,0.15)]";

            if (btnStereo) btnStereo.className = inactiveStyle;
            if (btnVocal) btnVocal.className = inactiveStyle;
            if (btnKaraoke) btnKaraoke.className = inactiveStyle;

            if (type === 'stereo' && btnStereo) btnStereo.className = activeCyanStyle;
            if (type === 'vocal' && btnVocal) btnVocal.className = activeCyanStyle;
            if (type === 'karaoke' && btnKaraoke) btnKaraoke.className = activeCyanStyle;

            // TODO: ส่งคำสั่ง MQTT หรือควบคุมการตัดเสียงเพิ่มเติมที่นี่ได้ครับ
            if (typeof sendMqttChannelCommand === 'function') {
                sendMqttChannelCommand(type);
            }
        }

        function clearSearch() {
            const input = document.getElementById('searchInput');
            if (input) input.value = '';
            switchMode('home');
            if (typeof fetchSongs === 'function') {
                fetchSongs('', '', true);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof checkAuthToken === 'function') {
                checkAuthToken('token', '/Login');
            }
        });
    </script>
</body>
</html>